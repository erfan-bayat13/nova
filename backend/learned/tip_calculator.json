{
  "name": "tip_calculator",
  "description": "Interactive tip calculator with bill, tip percentage, and split between people, showing tip, total and per-person amounts",
  "props_doc": "bill: number, starting bill amount; tipPercent: number, starting tip percentage; people: integer, number of people splitting; currency: string, currency symbol; presets: list of tip percentages shown as quick buttons",
  "html": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box}body{margin:0;padding:20px;font-family:-apple-system,system-ui,sans-serif;color:#f5f5f7;background:transparent;font-variant-numeric:tabular-nums}.sec{color:rgba(235,235,245,.62);font-size:13px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.field{margin-bottom:18px}.inp{display:flex;align-items:center;background:rgba(255,255,255,.08);border-radius:12px;padding:10px 14px;margin-top:6px}.inp span{color:rgba(235,235,245,.62);font-size:22px;margin-right:6px}.inp input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:inherit;font:inherit;font-size:26px;font-weight:600}.chips{display:flex;gap:8px;margin-top:8px}.chip{flex:1;padding:9px 0;border:0;border-radius:10px;background:rgba(255,255,255,.08);color:inherit;font:inherit;font-size:15px;cursor:pointer}.chip.on{background:#0a84ff;color:#fff}input[type=range]{width:100%;accent-color:#0a84ff;margin:10px 0 0}.step{display:flex;align-items:center;gap:14px}.step button{width:36px;height:36px;border-radius:18px;border:0;background:rgba(255,255,255,.08);color:inherit;font-size:20px;cursor:pointer}.step b{font-size:22px;min-width:24px;text-align:center}.res{margin-top:6px;padding-top:16px;border-top:1px solid rgba(255,255,255,.1)}.big{font-size:40px;font-weight:700;letter-spacing:-.5px;color:#0a84ff}.mini{display:flex;gap:24px;margin-top:10px}.mini div{flex:1}.mini b{display:block;font-size:20px;font-weight:600;margin-top:2px}@media (prefers-color-scheme:light){body{background:#fff;color:#1d1d1f;border-radius:18px}.sec,.inp span{color:rgba(60,60,67,.65)}.inp,.chip,.step button{background:rgba(0,0,0,.06)}.chip.on{background:#0a84ff}.res{border-color:rgba(0,0,0,.1)}}</style></head><body><div class=\"field\"><div class=\"sec\">Bill</div><div class=\"inp\"><span id=\"cur\">$</span><input id=\"bill\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"0.01\" placeholder=\"0.00\"></div></div><div class=\"field\"><div class=\"row\"><div class=\"sec\">Tip</div><b id=\"pct\">18%</b></div><div class=\"chips\" id=\"chips\"></div><input id=\"rng\" type=\"range\" min=\"0\" max=\"40\" step=\"1\" value=\"18\"></div><div class=\"field row\"><div class=\"sec\">Split between</div><div class=\"step\"><button id=\"minus\">&minus;</button><b id=\"ppl\">1</b><button id=\"plus\">+</button></div></div><div class=\"res\"><div class=\"sec\">Each person pays</div><div class=\"big\" id=\"each\">0.00</div><div class=\"mini\"><div><span class=\"sec\">Tip</span><b id=\"tip\">0.00</b></div><div><span class=\"sec\">Total</span><b id=\"tot\">0.00</b></div></div></div><script>var S={bill:0,tipPercent:18,people:1,currency:'$',presets:[15,18,20,25]};var $=function(i){return document.getElementById(i)};function f(n){return S.currency+(isFinite(n)?n:0).toFixed(2)}function chips(){var c=$('chips');c.innerHTML='';S.presets.forEach(function(p){var b=document.createElement('button');b.className='chip'+(p==S.tipPercent?' on':'');b.textContent=p+'%';b.onclick=function(){S.tipPercent=p;calc(true)};c.appendChild(b)})}function calc(rebuild){var bill=Math.max(0,S.bill||0),tip=bill*S.tipPercent/100,tot=bill+tip;$('pct').textContent=S.tipPercent+'%';$('rng').value=S.tipPercent;$('ppl').textContent=S.people;$('cur').textContent=S.currency;$('tip').textContent=f(tip);$('tot').textContent=f(tot);$('each').textContent=f(tot/S.people);if(rebuild)chips();parent.postMessage({type:'emit',name:'tip_changed',data:{bill:bill,tipPercent:S.tipPercent,people:S.people,tip:tip,total:tot,perPerson:tot/S.people}},'*')}$('bill').oninput=function(){S.bill=parseFloat(this.value)||0;calc(false)};$('rng').oninput=function(){S.tipPercent=parseInt(this.value,10);calc(true)};$('minus').onclick=function(){S.people=Math.max(1,S.people-1);calc(false)};$('plus').onclick=function(){S.people=Math.min(50,S.people+1);calc(false)};function render(d){d=d||{};if(typeof d.bill==='number'){S.bill=d.bill;$('bill').value=d.bill||''}if(typeof d.tipPercent==='number')S.tipPercent=d.tipPercent;if(typeof d.people==='number')S.people=Math.max(1,Math.round(d.people));if(typeof d.currency==='string')S.currency=d.currency;if(Array.isArray(d.presets)&&d.presets.length)S.presets=d.presets;var bill=Math.max(0,S.bill||0),tip=bill*S.tipPercent/100,tot=bill+tip;$('pct').textContent=S.tipPercent+'%';$('rng').value=S.tipPercent;$('ppl').textContent=S.people;$('cur').textContent=S.currency;$('tip').textContent=f(tip);$('tot').textContent=f(tot);$('each').textContent=f(tot/S.people);chips()}window.addEventListener('message',function(e){if(e.data&&e.data.type==='props')render(e.data.data)});render({});</script></body></html>",
